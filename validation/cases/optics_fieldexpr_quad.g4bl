# fieldexpr with a spatially-varying expression: a pure quadrupole field
# By=g*x, Bx=g*y with g=0.003 T/mm (=3 T/m).  Validates that the converter's
# auto-generated BDSIM field map preserves the spatial structure of the field
# (a transposed or mis-scaled map would fail this dramatically).
physics QGSP_BERT
param Pz=1000.0
reference referenceMomentum=$Pz particle=proton beamZ=0
beam gaussian particle=proton nEvents=3000 meanMomentum=$Pz beamZ=0 \
     beamX=10 sigmaX=0.5 sigmaY=0.5 sigmaXp=0.0002 sigmaYp=0.0002 sigmaP=0
fieldexpr Q width=160 height=160 length=300 By=0.003*x Bx=0.003*y
virtualdetector Det radius=300 length=1 format=ascii
place Q rename=Q1 z=500
place Det rename=DetEnd z=1500
