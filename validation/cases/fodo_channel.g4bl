# Long multi-cell FODO channel (vacuum, no iron, no fringe).
# Stress test: many elements, multiple detectors in drift regions,
# param expressions; quantitative optics comparison across the line.
physics QGSP_BERT
param Pz=1200.0
param Lq=150.0
param G=4.0
reference referenceMomentum=$Pz particle=proton beamZ=0
beam gaussian particle=proton nEvents=4000 meanMomentum=$Pz beamZ=0 \
     beamX=4 beamY=3 sigmaX=0.4 sigmaY=0.4 sigmaXp=0.0002 sigmaYp=0.0002 sigmaP=0
genericquad QF fieldLength=$Lq ironLength=0 apertureRadius=90 fringe=0 kill=0
genericquad QD fieldLength=$Lq ironLength=0 apertureRadius=90 fringe=0 kill=0
virtualdetector Det radius=300 length=1 format=ascii
place QF rename=QF0 gradient=$G z=600.0
place QD rename=QD0 gradient=-$G z=1200.0
place QF rename=QF1 gradient=$G z=1800.0
place QD rename=QD1 gradient=-$G z=2400.0
place Det rename=DET1 z=2700.0
place QF rename=QF2 gradient=$G z=3000.0
place QD rename=QD2 gradient=-$G z=3600.0
place QF rename=QF3 gradient=$G z=4200.0
place QD rename=QD3 gradient=-$G z=4800.0
place Det rename=DET3 z=5100.0
place QF rename=QF4 gradient=$G z=5400.0
place QD rename=QD4 gradient=-$G z=6000.0
place QF rename=QF5 gradient=$G z=6600.0
place QD rename=QD5 gradient=-$G z=7200.0
place Det rename=DET5 z=7500.0
place QF rename=QF6 gradient=$G z=7800.0
place QD rename=QD6 gradient=-$G z=8400.0
place QF rename=QF7 gradient=$G z=9000.0
place QD rename=QD7 gradient=-$G z=9600.0
place Det rename=DET7 z=9900.0
place Det rename=DETend z=10200.0
