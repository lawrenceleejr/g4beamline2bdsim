# Beamline with bends, quads and a sector bend (G4beamline)
# Proton beam, 1 GeV/c.

physics QGSP_BERT
param Pz=1000.0

reference referenceMomentum=$Pz particle=proton beamZ=0
beam gaussian particle=proton nEvents=500 meanMomentum=$Pz \
     sigmaX=2 sigmaY=2 sigmaXp=0.001 sigmaYp=0.001 sigmaP=5

# Quadrupole doublet
genericquad Q fieldLength=200 ironLength=200 ironRadius=150 apertureRadius=50 kill=1

# A rectangular (box-field) dipole, By in Tesla
genericbend Dbox fieldWidth=400 fieldHeight=200 fieldLength=500 \
    ironWidth=900 ironHeight=600 ironLength=500 kill=1

# An ideal sector bend defined by its angle
idealsectorbend Dsec angle=15 By=0.5 fieldCenterRadius=2000 \
    fieldInnerRadius=1800 fieldOuterRadius=2200 fieldHeight=200 kill=1

virtualdetector D radius=100 length=1

place Q rename=Q1 gradient=3.0 z=400
place Q rename=Q2 gradient=-3.0 z=900
place Dbox rename=B1 By=0.8 z=2000
place D rename=D1 z=3000
place Dsec z=4000
place D rename=D2 z=6000
