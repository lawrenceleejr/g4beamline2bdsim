! ======================================================================
! BDSIM (GMAD) model generated by g4beamline2bdsim
! ======================================================================
! Source: rf_solenoid.g4bl

! ---- conversion warnings ----
! WARNING: solenoid 'S1': central field B=5.856 T estimated from coil current density (thick-solenoid formula); verify against G4beamline field map.
! WARNING: rf cavity 'RF1': phase convention differs between G4beamline (phaseAcc) and BDSIM; verify the phase.
! WARNING: rf cavity 'RF2': phase convention differs between G4beamline (phaseAcc) and BDSIM; verify the phase.

! ---- element definitions ----
drift_1: drift, l=250*mm;
S1: solenoid, l=500*mm, B=5.856184903*T;
drift_2: drift, l=235*mm;
RF1: rfcavity, l=430*mm, E=6.88*MV, frequency=0.201*GHz, phase=0.6981317008;
drift_3: drift, l=170*mm;
RF2: rfcavity, l=430*mm, E=6.88*MV, frequency=0.201*GHz, phase=0.6981317008;
drift_4: drift, l=285*mm;
M1: multipole, l=200*mm, knl={0.599584916, 29.9792458};
drift_5: drift, l=499.5*mm;
DEnd: marker;  ! virtualdetector -> sampler

! ---- beamline ----
mainline: line=(drift_1, S1, drift_2, RF1, drift_3, RF2, drift_4, M1, drift_5, DEnd);
use, mainline;

! ---- beam ----
beam, particle="mu+",
      momentum=200*MeV,
      distrType="gauss",
      sigmaX=20*mm,
      sigmaY=20*mm,
      sigmaXp=0.02,
      sigmaYp=0.02,
      sigmaT=0.5*ns,
      sigmaE=0.05;

! ---- options ----
option, physicsList="g4QGSP_BERT", ngenerate=2000;

! ---- samplers ----
sample, range=DEnd;
