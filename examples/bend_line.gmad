! ======================================================================
! BDSIM (GMAD) model generated by g4beamline2bdsim
! ======================================================================
! Source: bend_line.g4bl

! ---- element definitions ----
drift_1: drift, l=300*mm;
Q1: quadrupole, l=200*mm, apertureType="circular", aper1=50*mm, k1=0.899377374;
drift_2: drift, l=300*mm;
Q2: quadrupole, l=200*mm, apertureType="circular", aper1=50*mm, k1=-0.899377374;
drift_3: drift, l=750*mm;
B1: rbend, l=500*mm, B=0.8*T;
drift_4: drift, l=749.5*mm;
D1: marker;  ! virtualdetector -> sampler
drift_5: drift, l=999.5*mm;
Dsec: sbend, l=523.5987756*mm, angle=0.2617993878;
drift_6: drift, l=1475.901224*mm;
D2: marker;  ! virtualdetector -> sampler

! ---- beamline ----
mainline: line=(drift_1, Q1, drift_2, Q2, drift_3, B1, drift_4, D1, drift_5, Dsec,
                drift_6, D2);
use, mainline;

! ---- beam ----
beam, particle="proton",
      momentum=1000*MeV,
      distrType="gauss",
      sigmaX=2*mm,
      sigmaY=2*mm,
      sigmaXp=0.001,
      sigmaYp=0.001,
      sigmaE=0.005;

! ---- options ----
option, physicsList="g4QGSP_BERT",
        ngenerate=500,
        beampipeRadius=200*mm,
        horizontalWidth=600*mm;

! ---- samplers ----
sample, range=D1;
sample, range=D2;
