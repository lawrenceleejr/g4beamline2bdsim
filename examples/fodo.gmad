! ======================================================================
! BDSIM (GMAD) model generated by g4beamline2bdsim
! ======================================================================
! Source: fodo.g4bl

! ---- element definitions ----
drift_1: drift, l=150*mm;
QF: quadrupole, l=300*mm, apertureType="circular", aper1=100*mm, k1=6.745330305;
drift_2: drift, l=700*mm;
QD: quadrupole, l=300*mm, apertureType="circular", aper1=100*mm, k1=-6.745330305;
drift_3: drift, l=549.5*mm;
DetEnd: marker;  ! virtualdetector -> sampler

! ---- beamline ----
mainline: line=(drift_1, QF, drift_2, QD, drift_3, DetEnd);
use, mainline;

! ---- beam ----
beam, particle="mu+",
      momentum=200*MeV,
      distrType="gauss",
      sigmaX=5*mm,
      sigmaY=5*mm,
      sigmaXp=0.002,
      sigmaYp=0.002,
      sigmaE=0.01;

! ---- options ----
option, physicsList="g4QGSP_BERT", ngenerate=1000;

! ---- samplers ----
sample, range=DetEnd;
